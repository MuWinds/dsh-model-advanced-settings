{
  "name": "@muwinds/dsh-model-advanced-settings",
  "version": "0.1.1",
  "description": "Model advanced settings for the DeepSeek Harness web UI: per-model thinking levels (reasoningEfforts), per-provider retry policy (finite / unlimited), and a subagent default model. · 模型高级设置：推理等级、重试策略（有限/无限）、Subagent 独立模型。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "thinking-levels",
    "reasoning-efforts",
    "retry-policy",
    "subagent"
  ],
  "license": "MIT",
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
